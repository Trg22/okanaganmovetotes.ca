<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Sky -->
  <rect width="400" height="180" fill="#87ceeb"/>
  <!-- Ground -->
  <rect y="180" width="400" height="120" fill="#90ee90"/>
  <!-- House -->
  <rect x="240" y="120" width="130" height="90" fill="#e6c9a8"/>
  <!-- Roof -->
  <polygon points="240,120 305,50 370,120" fill="#8b4513"/>
  <!-- Door -->
  <rect x="290" y="160" width="30" height="50" fill="#654321"/>
  <!-- Van body -->
  <rect x="30" y="140" width="120" height="50" fill="#f5f5f5" stroke="#333" stroke-width="2"/>
  <!-- Van cab -->
  <rect x="20" y="135" width="40" height="30" fill="#dcdcdc" stroke="#333" stroke-width="2"/>
  <!-- Windows -->
  <rect x="25" y="140" width="15" height="12" fill="#87ceeb"/>
  <rect x="65" y="145" width="20" height="15" fill="#87ceeb"/>
  <!-- Wheels -->
  <circle cx="50" cy="195" r="8" fill="#333"/>
  <circle cx="130" cy="195" r="8" fill="#333"/>
  <!-- Tote boxes stacked -->
  <rect x="85" y="115" width="20" height="25" fill="#f5a800" stroke="#333" stroke-width="1"/>
  <rect x="105" y="110" width="20" height="25" fill="#f5a800" stroke="#333" stroke-width="1"/>
  <rect x="125" y="105" width="20" height="25" fill="#f5a800" stroke="#333" stroke-width="1"/>
</svg>